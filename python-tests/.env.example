# Base URL of the Fiori trial landing page
BASE_URL=https://account.hanatrial.ondemand.com/

# Browser settings
BROWSER=chromium
HEADLESS=true

# Credentials – never commit real values.
# In CI, these are injected from Jenkins Credentials Store.
FIORI_USERNAME=example@example.com
FIORI_PASSWORD=change-me

# Test data
SUBACCOUNT_NAME=Tester
SUBACCOUNT_DESCRIPTION=Test
SUBACCOUNT_REGION=US East (VA) - AWS
DISPLAY_TEXT_REPEAT=15
DESC_TEXT_REPEAT=10

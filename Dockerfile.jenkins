# ---------- Stage 1: build / plugin preparation ----------
FROM jenkins/jenkins:lts-jdk21 AS builder

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# ---------- Stage 2: runtime ----------
FROM jenkins/jenkins:lts-jdk21

ARG JENKINS_UID=1000
ARG JENKINS_GID=1000

USER root

# The controller only orchestrates: every test suite runs in its own
# container (robot-local, playwright-local, python-tests-local) through the
# dind sidecar, so no test runtime (Python/Node/Playwright) is installed here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        tini \
        openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod -g ${JENKINS_GID} jenkins \
    && usermod  -u ${JENKINS_UID} -g ${JENKINS_GID} jenkins

# Docker CLI for the dind sidecar; same version as the daemon image.
COPY --from=docker:24-dind /usr/local/bin/docker /usr/local/bin/docker

# Copy prepared plugins from builder
COPY --from=builder --chown=jenkins:jenkins /usr/share/jenkins/ref/ /usr/share/jenkins/ref/

# Drop privileges
USER jenkins

ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false -XX:MaxRAMPercentage=75.0"
EXPOSE 8080 50000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/jenkins.sh"]

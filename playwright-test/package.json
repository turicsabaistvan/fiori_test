    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.7.5",
    "dotenv": "16.4.5",
    "eslint": "9.13.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0"
  }
}
